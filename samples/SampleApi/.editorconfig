root = true

[*.cs]
# Show the MigrationLint diagnostics as errors — red squiggles in the editor (best for a
# screenshot). The IDE still shows them live even though `dotnet build` will now report errors.
# Change to `warning` if you'd rather the sample build cleanly.
dotnet_diagnostic.MIG007.severity = error
dotnet_diagnostic.MIG004.severity = error
