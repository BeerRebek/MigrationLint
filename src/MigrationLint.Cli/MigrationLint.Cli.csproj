<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Ship net8.0 for broad reach; net10.0 exists so the local debugger matches the installed runtime. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrationlint</ToolCommandName>
    <RollForward>LatestMajor</RollForward>
    <PackageId>MigrationLint.Cli</PackageId>
    <Description>The EF Core migration linter that understands database locks. Run as a dotnet tool in any CI system.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MigrationLint.Core/MigrationLint.Core.csproj" />
  </ItemGroup>

</Project>
