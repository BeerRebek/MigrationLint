<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>MigrationLint.Analyzers</PackageId>
    <Description>Roslyn analyzer + code fixes for MigrationLint — see EF Core migration lock/data-loss diagnostics inline in Visual Studio and Rider.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- The rule engine references MigrationLint.Core; RS1038 warns that analyzers should only
         reference Roslyn. We ship Core alongside the analyzer (see the ItemGroup below), so it is
         safe here. Proper single-assembly packaging is a follow-up. -->
    <NoWarn>$(NoWarn);RS1038;RS1036;RS1035;RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MigrationLint.Core/MigrationLint.Core.csproj" />
  </ItemGroup>

  <!-- Package the analyzer + its Core dependency into the analyzers/ path so the IDE loads both. -->
  <ItemGroup>
    <None Include="$(OutputPath)/MigrationLint.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)/MigrationLint.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
